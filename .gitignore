# Benchmark runs are scratch. bench/capacity.sh writes a timestamped directory
# per run and compiles mumax3 builds into work/ inside it; crosstool/ scripts
# drop raw JSON and logs beside themselves. The record that is kept is
# crosstool/RESULTS.md, refreshed deliberately rather than by accumulation.
bench/results-*/
bench/capacity-*/
bench/__pycache__/
bench/bench.out/
