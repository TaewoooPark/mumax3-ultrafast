{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mumax3 ultrafast",
  "version": "0.1.0",
  "identifier": "io.github.taewoopark.mumax3-ultrafast",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost http://127.0.0.1:* blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "mumax3 ultrafast",
        "width": 1440,
        "height": 940,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "backgroundColor": "#ffffff",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
