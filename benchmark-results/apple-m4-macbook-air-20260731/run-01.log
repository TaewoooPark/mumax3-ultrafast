//output directory: run-01.out/
//not starting GUI (-http="")
msat = 800e3
aex = 13e-12
alpha = 0.01
c := 4e-9
setcellsize(c, c, c)
setsolver(2)
e := 11
n := pow(2, e)
setgridsize(n, n, 1)
print(n, "x", n)
//2048 x 2048
steps(1)
//Did not use cached kernel: open /var/folders/7x/ldgmfnbx3zn474dpx_246g400000gn/T//mumax3kernel_[2048 2048 1]_[0 0 0]_[4e-09 4e-09 4e-09]_6_0 0.ovf: no such file or directory
