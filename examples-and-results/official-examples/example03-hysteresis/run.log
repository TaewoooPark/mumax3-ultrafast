//output directory: output.out/
//not starting GUI (-http="")
SetGridsize(128, 32, 1)
SetCellsize(4e-9, 4e-9, 30e-9)
// WARNING: cell size was set to a high aspect ratio.
//          Calculation of demag kernel may take longer than usual.
//          Note that this can exacerbate discretization anisotropy.
Msat = 800e3
Aex = 13e-12
m = randomMag()
relax()
//Using cached kernel: /var/folders/7x/ldgmfnbx3zn474dpx_246g400000gn/T//mumax3kernel_[128 32 1]_[0 0 0]_[4e-09 4e-09 3e-08]_6_
Bmax := 100.0e-3
Bstep := 1.0e-3
MinimizerStop = 1e-6
TableAdd(B_ext)
for B := 0.0; B <= Bmax; B += Bstep {
	B_ext = vector(B, 0, 0)
	minimize()
	tablesave()
}
for B := Bmax; B >= -Bmax; B -= Bstep {
	B_ext = vector(B, 0, 0)
	minimize()
	tablesave()
}
for B := -Bmax; B <= Bmax; B += Bstep {
	B_ext = vector(B, 0, 0)
	minimize()
	tablesave()
}
