//output directory: output.out/
//not starting GUI (-http="")
Nx := 256
Ny := 256
Nz := 1
setgridsize(Ny, Nx, Nz)
c := 4e-9
setcellsize(c, c, c)
setgeom(circle(Nx * c))
// Initializing geometry 0 %
// Initializing geometry 100 %
Msat = 800e3
Aex = 12e-13
alpha = 1
m = vortex(1, 1)
save(m)
save(m.Comp(0))
save(Crop(m, 0, Nx/2, 0, Ny/2, 0, Nz))
mx := m.Comp(0)
mx_center := CropY(mx, Ny/4, 3*Ny/4)
save(mx_center)
