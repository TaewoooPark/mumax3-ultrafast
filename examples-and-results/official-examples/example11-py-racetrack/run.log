//output directory: output.out/
//not starting GUI (-http="")
setGridSize(256, 64, 1)
setCellSize(3e-9, 3e-9, 10e-9)
Msat = 860e3
Aex = 13e-12
Xi = 0.1
alpha = 0.02
m = twodomain(1, 0, 0, 0, 1, 0, -1, 0, 0)
notches := rect(15e-9, 15e-9).RotZ(45*pi/180).Repeat(200e-9, 64*3e-9, 0).Transl(0, 32*3e-9, 0)
setGeom(notches.inverse())
// Initializing geometry 1 %
// Initializing geometry 100 %
BoundaryRegion := 0
MagLeft := 1
MagRight := -1
ext_rmSurfaceCharge(BoundaryRegion, MagLeft, MagRight)
relax()
//Using cached kernel: /var/folders/7x/ldgmfnbx3zn474dpx_246g400000gn/T//mumax3kernel_[256 64 1]_[0 0 0]_[3e-09 3e-09 1e-08]_6_
ext_centerWall(0)
autosave(m, 50e-12)
tableadd(ext_dwpos)
tableautosave(10e-12)
pol = 0.56
J = vector(-10e12, 0, 0)
Run(0.5e-9)
