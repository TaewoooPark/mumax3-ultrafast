/* 
	Test rk4 solver with temperature
*/

c := 10e-9
setcellsize(c, c, c)
setgridsize(256, 256, 1)

Msat  = 1e6 
Aex   = 0 
alpha = 0.1 
AnisU = vector(0, 0, 1)
m     = uniform(0, 0, 1)
fixdt = 2e-12
ThermSeed(0)
Temp  = 100              
Ku1   = 1e4/4
enabledemag = false
setsolver(4)

run(5e-9) 
avgM := m.average()
print(avgM)

// CUDA and Metal use different deterministic random-number generators.
// Test the transverse sample mean statistically while keeping the tighter
// equilibrium check for the longitudinal component.
expect("mx", avgM[0], 0, 5e-3)
expect("my", avgM[1], 0, 5e-3)
expect("mz", avgM[2], 0.8366, 1e-3)
