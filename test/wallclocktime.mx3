// All benchmarks mentioned in comments were run on RTX 3080 (mobile).
// ! Timings must have sufficient margin such that very weak and very strong GPUs still pass this test !

SetGridSize(256, 256, 1)
SetCellSize(5e-9, 5e-9, 3e-9)
Aex   = 13e-12
Msat  = 800e3
alpha = 0.02


//// Fully run relax/minimize (use a situation that relaxes very quickly)
m = Uniform(1, 0, 0)
B_ext = Vector(1, 0, 0)
ExpectB("Relax converged", Relax(), true) // Takes 0.25s to converge
ExpectB("Minimize converged", Minimize(), true) // Takes an additional 0.003s to converge


//// Interrupt relax/minimize
B_ext = Vector(0, 0, 0)
wallclockLimit := 0.5
maxOvershoot := 0.25 // An in-flight GPU step cannot be interrupted.

m = RandomMag()
RelaxWallclockTime = wallclockLimit // Takes 49s to converge without a limit.
t0 := now()
ExpectB("Relax not converged", Relax(), false)
relaxElapsed := since(t0).Seconds()
ExpectB("Relax ran until limit", relaxElapsed >= RelaxWallclockTime, true)
ExpectB("Relax bounded overshoot", relaxElapsed <= RelaxWallclockTime + maxOvershoot, true)

m = RandomMag()
MinimizeWallclockTime = wallclockLimit // Takes 5.5s to converge without a limit.
t0 = now()
ExpectB("Minimize not converged", Minimize(), false)
minimizeElapsed := since(t0).Seconds()
ExpectB("Minimize ran until limit", minimizeElapsed >= MinimizeWallclockTime, true)
ExpectB("Minimize bounded overshoot", minimizeElapsed <= MinimizeWallclockTime + maxOvershoot, true)
